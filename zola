#!/usr/bin/env sh
# Downloads a pinned Zola release on first use, then runs it with the given arguments.
# Cloudflare Pages build command: ./zola build
set -eu

# Pinned here on purpose: a ZOLA_VERSION env var left in the Cloudflare dashboard must not override it.
ZOLA_VERSION="0.23.6"
DIR="$(cd "$(dirname "$0")" && pwd)/.zola"
BIN="$DIR/zola-v${ZOLA_VERSION}"

if [ ! -x "$BIN" ]; then
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64)          TARGET="x86_64-unknown-linux-gnu" ;;
    Linux-aarch64)         TARGET="aarch64-unknown-linux-gnu" ;;
    Darwin-x86_64)         TARGET="x86_64-apple-darwin" ;;
    Darwin-arm64)          TARGET="aarch64-apple-darwin" ;;
    *) echo "zola: unsupported platform $(uname -s)-$(uname -m)" >&2; exit 1 ;;
  esac
  URL="https://github.com/getzola/zola/releases/download/v${ZOLA_VERSION}/zola-v${ZOLA_VERSION}-${TARGET}.tar.gz"
  echo "zola: downloading v${ZOLA_VERSION} (${TARGET})" >&2
  mkdir -p "$DIR"
  curl -fsSL "$URL" | tar -xz -C "$DIR"
  mv "$DIR/zola" "$BIN"
fi

# Cloudflare Pages preview deployments live on their own *.pages.dev URL. Without this,
# every asset link points at the production base_url and the preview renders unstyled.
if [ "${1:-}" = "build" ] && [ -n "${CF_PAGES_URL:-}" ] && [ "${CF_PAGES_BRANCH:-main}" != "main" ]; then
  case " $* " in
    *" --base-url"*|*" -u "*) ;;
    *) set -- "$@" --base-url "$CF_PAGES_URL" ;;
  esac
fi

exec "$BIN" "$@"
